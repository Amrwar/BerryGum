# PixelCraft Studio - Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# RESEND EMAIL SERVICE (Optional)
# ===========================================
# Get your API key from https://resend.com/api-keys
# If not set, contact form submissions will be logged to console
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# Email address to receive contact form submissions
# Default: hello@pixelcraftstudio.com
CONTACT_EMAIL=your-email@example.com

# ===========================================
# SITE CONFIGURATION (Optional overrides)
# ===========================================
# These can override values in lib/config.ts

# Site URL (used for SEO and social sharing)
NEXT_PUBLIC_SITE_URL=https://pixelcraftstudio.com

# WhatsApp business number (with country code, no + prefix)
NEXT_PUBLIC_WHATSAPP_NUMBER=201234567890

# ===========================================
# ANALYTICS (Optional)
# ===========================================
# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Facebook Pixel ID
NEXT_PUBLIC_FB_PIXEL_ID=xxxxxxxxxxxxx

# ===========================================
# DEVELOPMENT
# ===========================================
# Set to 'development' for local, 'production' for live
NODE_ENV=development
